# Crooked Pantry environment variables
#
# Copy this file to `.env.local` for local development.
# All variables are optional. When no AI provider key is present, the app
# falls back to a built-in mock AI provider so development stays zero-setup.
#
# Vite only exposes variables prefixed with `VITE_` to the client bundle.

# AI provider to use for food suggestions.
# Supported values:
#   mock    - deterministic local fallback, no network calls
#   openai  - OpenAI-compatible chat completions API
#   custom  - use VITE_AI_ENDPOINT for a custom or local LLM endpoint
VITE_AI_PROVIDER=mock

# API key for the selected AI provider.
# Leave blank when using the mock provider.
# Examples:
#   VITE_AI_API_KEY=sk-...
#   VITE_AI_API_KEY=local
VITE_AI_API_KEY=

# Optional model name.
# If blank, the app uses a sensible default for the selected provider.
# Examples:
#   gpt-4o-mini
#   gpt-4o
#   llama3.1
VITE_AI_MODEL=

# Optional custom AI endpoint.
# Useful for local LLM servers, proxies, or OpenAI-compatible APIs.
# Examples:
#   https://api.openai.com/v1/chat/completions
#   http://localhost:11434/v1/chat/completions
VITE_AI_ENDPOINT=

# Force the mock AI provider even when an API key is present.
# Useful for offline development or testing the UI without spending tokens.
# Values: true | false
VITE_FORCE_MOCK_AI=false

# Base URL used when generating shareable links.
# If blank, the app uses the current browser origin at runtime.
# Examples:
#   https://crooked-pantry.example.com
#   http://localhost:5173
VITE_SHARE_BASE_URL=

# App name included in shared text and competition invites.
VITE_APP_NAME=Crooked Pantry

# Enable verbose console logging for AI requests, share encoding, and
# device motion debugging.
# Values: true | false
VITE_DEBUG=false